# Build context = only what `pnpm install` + `pnpm build` need.
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
**/.vite

# Tests and test output are not part of the image.
**/test
e2e
tools
playwright-report
test-results
reports
.stryker-tmp

# Repo metadata, docs, design sources and tooling state.
.git
.github
.claude
.superpowers
.playwright-mcp
docs
spec (1).md
*.md

# design/: only what the client build imports (tokens + webp assets); concept art and
# reference screenshots stay out. `design/*` (not `design`) so the re-includes below apply.
design/*
!design/tokens
!design/assets

# Secrets and local noise. Never send env files into the build context.
.env
.env.*
*.log
.DS_Store
Thumbs.db
