{
  "name": "@stackerist/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, deterministic Stackerist rules engine. No I/O, no Date, no Math.random.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@stackerist/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "vitest": "5.1.0"
  }
}
